# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# .env ถูก gitignore ไว้แล้ว จะไม่ถูก commit
#
#   Copy-Item .env.example .env
#
# ห้ามใส่ token ลงในไฟล์ที่ commit ได้ และห้ามวางใน chat/issue/PR
# ถ้า token หลุดออกไปที่ใดก็ตาม ให้เพิกถอนทันทีที่
#   https://huggingface.co/settings/tokens

# Hugging Face access token (ต้องเป็นชนิด write ถ้าจะ push โมเดล)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ชื่อ repo ปลายทางบน Hugging Face
HF_REPO=Datchthana/typhoon-7b-neuro-cpt

# บังคับ UTF-8 บน Windows (console เริ่มต้นเป็น cp874 ซึ่ง encode ภาษาไทยไม่ได้)
PYTHONIOENCODING=utf-8
